# How /screenshots brings this product up for a capture run. Sourced by scripts/setup.sh and
# scripts/teardown.sh. Committed, so never put a secret here: credentials stay in the apps'
# own .env files.
#
# The skill fills in what's missing on its first run (Learning protocol, .claude/README.md).
# Paths are relative to the repository root.

# The webapp, and a URL that answers (any status) once it's up.
WEBAPP_DIR='webapp'
WEBAPP_URL='http://localhost:3000'
WEBAPP_START='npm run dev'

# The backend: started only if BACKEND_URL doesn't answer. Any status but "no connection" means
# up (a 401 is a fine sign of life). Leave BACKEND_START empty if the webapp needs no backend.
BACKEND_DIR='server/backend'
BACKEND_URL='http://localhost:8080/v1/notes'
BACKEND_START='mvn -q spring-boot:run'
# Environment for the backend run. Use it to switch OFF every outgoing notification (email,
# SMS, messaging): demo data carries fictional contact details that must stay unreachable.
BACKEND_ENV=''
# A docker compose file the backend needs (its database), or empty.
COMPOSE_FILE=''

# A command that prints a number > 0 when the demo data is in place, or empty to skip the
# check. Seeding is always left to a human (SEED_DOCS says how).
SEED_CHECK=''
SEED_DOCS=''

# Where the logged-in browser session is saved: outside the repository, it's a credential.
# Empty if the webapp needs no login.
SESSION_FILE="$HOME/.acme/screenshots/session.json"

# Set before the app's first paint: the locale cookie and theme key the webapp reads
# (webapp/lib/i18n/config.ts, next-themes), and any extra localStorage entries that keep
# distractions out of shot, as space-separated key=value pairs.
LOCALE_COOKIE='NEXT_LOCALE'
THEME_STORAGE_KEY='theme'
EXTRA_LOCAL_STORAGE=''
