# Copy to .env.local (git-ignored) and fill in. Never commit real values.
AUTH0_SECRET='<the result of running: openssl rand -hex 32>'
APP_BASE_URL='http://localhost:3000'
AUTH0_DOMAIN='<your tenant>.auth0.com'
AUTH0_CLIENT_ID=''
AUTH0_CLIENT_SECRET=''
# The API base URL, as seen from the browser. Also the Auth0 API audience.
NEXT_PUBLIC_API_ENDPOINT='http://localhost:8080/v1'
