# syntax=docker.io/docker/dockerfile:1
FROM node:26.10.0-alpine AS base

# Install dependencies
FROM base AS deps
RUN apk add --no-cache libc6-compat openjdk21-jre-headless
WORKDIR /app

COPY webapp/package.json webapp/package-lock.json* webapp/.npmrc* webapp/openapitools.json ./
COPY server/backend/src/main/resources/api/v1.yml /server/backend/src/main/resources/api/v1.yml

RUN \
  if [ -f package-lock.json ]; then npm ci; \
  else echo "Lockfile not found." && exit 1; \
  fi

# Rebuild the source code
FROM base AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/autogenerated ./autogenerated
COPY webapp/ .

ENV NEXT_TELEMETRY_DISABLED=1

# Client components call the backend directly from the browser, so this must be
# the publicly reachable API host, not the internal `server:8080` one used for
# server-side calls. Inlined into the JS bundle at build time (NEXT_PUBLIC_*).
ARG NEXT_PUBLIC_API_ENDPOINT=https://api.acme.example/v1
ENV NEXT_PUBLIC_API_ENDPOINT=$NEXT_PUBLIC_API_ENDPOINT

RUN \
  if [ -f package-lock.json ]; then npm run build; \
  else echo "Lockfile not found." && exit 1; \
  fi

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000

ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
