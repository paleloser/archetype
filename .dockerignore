# Build context rules for images built from the repository root.
#
# Only `webapp` builds from here: its `postinstall` hook generates the API
# client from `server/backend/src/main/resources/api/v1.yml`, which sits
# outside `webapp/` and therefore has to be inside the context. `server` and
# `web` build from their own directories and use their own .dockerignore.

.git
.github
.codegraph
.claude
.idea
deploy
**/.DS_Store
**/*.iml

# Build output and dependencies: always reinstalled/regenerated in the image.
**/node_modules
**/.next
**/target
**/*.tsbuildinfo

# Regenerated during `npm ci`; a stale local copy must never win.
webapp/autogenerated

# Never ship developer secrets into a layer.
**/.env
**/.env.*.local
**/.env.local

# Not needed by the webapp build.
web
server/docker-compose.yml
server/Dockerfile
